@startuml zack-profile-objects
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceParticipant underline false
title Immediately after selecting Zheng Yiting at startup

object "<u>session : GameSession</u>" as session
object "<u>board : Board</u>" as board {
    rows = 9
    cols = 9
    totalMines = 10
    gameState = IN_PROGRESS
    isFirstMove = true
}
object "<u>manager : ProfileManager</u>" as manager {
    activeProfileId = "11111111-1111-4111-8111-111111111111"
}
object "<u>selectedPlayer : Profile</u>" as selectedPlayer {
    id = "11111111-1111-4111-8111-111111111111"
    name = "Zheng Yiting"
}
object "<u>guest : Profile</u>" as guest {
    id = "22222222-2222-4222-8222-222222222222"
    name = "Guest"
}

session -right-> board
session -down-> manager
manager -down-> selectedPlayer
manager -right-> guest
@enduml
